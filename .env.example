# Application Settings
TIMEZONE=America/Sao_Paulo
CRON_HOUR=6
CRON_MINUTE=30
DESTINATION_PHONE=5511999999999

# Google Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google Calendar (via Service Account JSON ou via URL secreta iCal/ICS)
GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/service_account.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ICS_URL=

# Evolution API / WhatsApp
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=auto_generated_key_change_me
INSTANCE_NAME=agenda-notifier
